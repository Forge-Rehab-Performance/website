            "evidence": "01 uses cinematic scale, proof cells, rails, and technical blocks; 02 uses folios, margin notes, reading columns, and journal modules."
          },
          "CTA": {
            "score": 1,
            "evidence": "Both pair one active Approach text link with the same disabled booking component, though surface treatment and placement differ."
          },
          "services": {
            "score": 2,
            "evidence": "01 separates clinical pathways from a protocol rail; 02 narrates the stages as numbered journal entries with explanatory notes."
          },
          "trust": {
            "score": 1,
            "evidence": "Both rely on Brandon's verified credentials and one-on-one care; presentation differs between a technical authority block and practitioner essay."
          },
          "sectionOrder": {
            "score": 2,
            "evidence": "01 moves proof to pathways, protocol, and authority; 02 moves evidence folio to audiences, stage journal, and practitioner note."
          },
          "imagery": {
            "score": 1,
            "evidence": "Both use two images from the same stock set, with distinct strength-led cinematic and court-led editorial crops."
          },
          "density": {
            "score": 2,
            "evidence": "01 packs condensed information into dark rails and cells; 02 uses measured reading passages, notes, and paper whitespace."
          },
          "motion": {
            "score": 2,
            "evidence": "01 performs a hero clip reveal; 02 is static apart from smooth scrolling, with reduced-motion handling in both."
          },
          "navigation": {
            "score": 1,
