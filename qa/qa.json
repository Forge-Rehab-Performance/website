        "categories": {
          "typography": {
            "score": 2,
            "evidence": "01 uses condensed Oswald for display type with Arial/system sans for body copy; 02 uses large Georgia serif with compact sans-serif folios and notes."
          },
          "hero": {
            "score": 2,
            "evidence": "01 overlays authority copy on a dark full-frame strength crop; 02 places a quiet editorial premise beside a contained court portrait."
          },
          "hierarchy": {
