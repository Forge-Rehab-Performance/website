---
import BookingStatus from '../../BookingStatus.astro';
import { faqCategories } from '../../../data/faq';
---

<section class="inner-hero faq-v7-hero" aria-labelledby="faq-title">
  <div class="section-shell inner-hero__grid">
    <div>
      <p class="eyebrow">FAQ</p>
      <h1 id="faq-title">Questions,<br /><span>answered.</span></h1>
    </div>
    <div class="inner-hero__aside">
      <p class="hero-lede">Everything you need to know about one-on-one care at Forge, pricing, insurance, the gym setting, and getting started.</p>
    </div>
  </div>
</section><section class="faq-directory-v8">
  <div class="section-shell">
    <div class="faq-directory-v8__grid">
      <!-- Left Sidebar -->
      <div class="faq-sidebar mobile-jump-menu">
        <button type="button" class="mobile-jump-menu__summary" id="faq-jump-toggle" aria-expanded="false" aria-controls="faq-jump-nav">
          <span class="mobile-jump-menu__active-text" data-jump-text>Jump to section...</span>
          <span class="mobile-jump-menu__icon" aria-hidden="true">↓</span>
        </button>
        <nav id="faq-jump-nav" aria-label="FAQ Categories">
          <ul class="faq-sidebar__list">
            {faqCategories.map((category) => (
              <li>
                <a href={`#faq-category-${category.id}`} data-scroll-spy-link={`faq-category-${category.id}`} class="faq-sidebar__link">
                  {category.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Right Content -->
      <div class="faq-content">
        {faqCategories.map((category) => (
          <section id={`faq-category-${category.id}`} class="faq-category-section">
            <h2>{category.title}</h2>
            <div class="faq-list">
              {category.questions.map(([question, answer]) => (
                <details class="faq-item">
                  <summary>
                    <strong>{question}</strong>
                    <span aria-hidden="true">+</span>
                  </summary>
                  <div>
                    <p>{answer}</p>
                    {question === 'How much does physical therapy cost?' && (
                      <a class="text-link" href="/concept-01/pricing/">View full pricing <span aria-hidden="true">→</span></a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="home-v3-close faq-v7-close" aria-labelledby="faq-close-title">
  <div class="section-shell home-v3-close__grid">
    <div>
      <p class="eyebrow">STILL HAVE QUESTIONS?</p>
      <h2 id="faq-close-title">We're happy to help.</h2>
      <p>If you don't see your question answered here, reach out and we'll get you the information you need.</p>
      <a class="text-link" href="/concept-01/contact/">Contact Forge <span aria-hidden="true">→</span></a>
    </div>
    <BookingStatus />
  </div>
</section>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '-10% 0px -80% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        document.querySelectorAll('[data-scroll-spy-link]').forEach(link => {
          if (link.getAttribute('data-scroll-spy-link') === id) {
            link.classList.add('is-active');
            // Update mobile summary text
            const jumpText = document.querySelector('[data-jump-text]');
            if (jumpText) {
              jumpText.textContent = link.textContent;
            }
          } else {
            link.classList.remove('is-active');
          }
        });
      }
    });
  }, observerOptions);

  document.querySelectorAll('section[id^="faq-category-"]').forEach(section => {
    observer.observe(section);
  });

  document.querySelectorAll('[data-scroll-spy-link]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href');
      if (!targetId) return;
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
        // Close menu on mobile
        const menu = link.closest('.mobile-jump-menu');
        if (menu) {
          menu.classList.remove('is-open');
          const toggle = menu.querySelector('#faq-jump-toggle');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }
      }
    });
  });

  const jumpToggle = document.getElementById('faq-jump-toggle');
  if (jumpToggle) {
    jumpToggle.addEventListener('click', () => {
      const menu = jumpToggle.closest('.mobile-jump-menu');
      if (menu) {
        const isOpen = menu.classList.toggle('is-open');
        jumpToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
    });
  }
</script>

<style>
  .faq-v7-hero {
    padding-block: clamp(2.8rem, 4.8vw, 4.6rem);
  }

  .faq-v7-hero h1 {
    font-size: clamp(3.35rem, 5.8vw, 5.9rem);
  }

  .faq-directory-v8 {
    padding: clamp(2.2rem, 4vw, 3.7rem) 0;
    background: #0b0c0b;
  }

  .faq-directory-v8__grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 4rem;
  }

  .faq-sidebar {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .faq-sidebar nav {
    display: block;
  }

  .mobile-jump-menu__summary {
    display: none;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    padding: 0;
  }

  .faq-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-sidebar__link {
    display: block;
    color: var(--text-faint, #6f716b);
    text-decoration: none;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }

  .faq-sidebar__link:hover {
    color: var(--ivory, #fff);
  }

  .faq-sidebar__link.is-active {
    color: var(--gold-bright, #dda947);
  }

  .faq-content {
    min-width: 0;
  }

  .faq-category-section {
    padding-bottom: 5rem;
  }

  .faq-category-section:last-child {
    padding-bottom: 0;
  }

  .faq-category-section h2 {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--ivory);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    margin-bottom: 2rem;
    margin-top: 0;
  }

  .faq-list {
    border-top: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: .8rem;
    align-items: center;
    min-height: 3.8rem;
    padding: .75rem 1rem;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }
  
  .faq-item summary:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary strong {
    color: var(--ivory);
    font: 700 clamp(.88rem, 1.3vw, 1.05rem)/1.3 'Oswald', sans-serif;
    text-transform: uppercase;
  }

  .faq-item summary span {
    color: var(--gold-bright);
    font-size: 1.35rem;
    text-align: center;
    transition: transform .18s ease;
  }

  .faq-item[open] summary span { transform: rotate(45deg); }

  .faq-item > div {
    max-width: 48rem;
    padding: 0 2rem 1rem 0;
    color: var(--text-dim);
    font-size: .8rem;
    line-height: 1.65;
  }

  .faq-item > div p { margin: 0 0 .55rem; }

  .faq-v7-close {
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
  }

  @media (max-width: 52rem) {
    .faq-v7-hero {
      padding-block: 2.5rem;
    }

    .faq-v7-hero h1 {
      font-size: clamp(3rem, 12vw, 4.4rem);
    }

    .faq-directory-v8__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .faq-sidebar {
      display: block;
      position: sticky;
      top: 0;
      background: var(--black, #0b0c0b);
      z-index: 10;
      padding: 0;
      border-bottom: 1px solid var(--line);
      margin: 0 -1.25rem;
    }

    .faq-sidebar:not(.is-open) nav {
      display: none;
    }

    .mobile-jump-menu__summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.25rem;
      cursor: pointer;
      font-family: 'Oswald', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--ivory, #fff);
      list-style: none;
    }

    .mobile-jump-menu__summary::-webkit-details-marker {
      display: none;
    }

    .faq-sidebar.is-open .mobile-jump-menu__icon {
      transform: rotate(180deg);
    }
    
    .mobile-jump-menu__icon {
      transition: transform 0.2s ease;
      color: var(--gold-bright, #dda947);
    }

    .faq-sidebar nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--black, #0b0c0b);
      border-bottom: 1px solid var(--line);
      padding: 1rem 1.25rem;
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5);
    }
    
    .faq-sidebar__list {
      flex-direction: column;
      gap: 1rem;
    }

    .faq-sidebar__link {
      white-space: normal;
      padding: 0.5rem 0;
    }
    
    .faq-category-section {
      padding-bottom: 3rem;
    }

    .faq-item summary {
      min-height: 3.65rem;
      padding: .72rem 0;
    }

    .faq-item > div {
      padding-right: .5rem;
    }
  }
</style>
