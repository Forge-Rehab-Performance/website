---
import BookingStatus from '../../BookingStatus.astro';
import { faqCategories } from '../../../data/faq';
---

<section class="inner-hero faq-v7-hero" aria-labelledby="faq-title">
  <div class="section-shell inner-hero__grid">
    <div>
      <p class="eyebrow">FAQ</p>
      <h1 id="faq-title">Questions,<br /><span>answered.</span></h1>
    </div>
    <div class="inner-hero__aside">
      <p class="hero-lede">Everything you need to know about one-on-one care at Forge, pricing, insurance, the gym setting, and getting started.</p>
      <a class="text-link" href="/concept-01/contact/">Still have a question? Contact Forge <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="faq-v7-section" aria-labelledby="faq-explorer-title">
  <div class="section-shell">
    <div class="faq-explorer" data-faq-explorer>
      <div class="faq-explorer__categories" role="tablist" aria-label="FAQ categories" aria-orientation="vertical">
        <p class="faq-explorer__label" id="faq-explorer-title">Browse by topic</p>
        {faqCategories.map((category, index) => (
          <button
            type="button"
            class="faq-explorer__category"
            role="tab"
            id={`faq-tab-${category.id}`}
            aria-controls={`faq-panel-${category.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? '0' : '-1'}
            data-faq-category={index}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{category.title}</strong>
          </button>
        ))}
      </div>

      <div class="faq-explorer__content">
        {faqCategories.map((category, categoryIndex) => (
          <section
            class="faq-explorer__panel"
            id={`faq-panel-${category.id}`}
            role="tabpanel"
            aria-labelledby={`faq-tab-${category.id}`}
            data-faq-panel={categoryIndex}
            hidden={categoryIndex !== 0}
          >
            <header class="faq-explorer__panel-header">
              <div>
                <p class="eyebrow">{String(categoryIndex + 1).padStart(2, '0')} / {String(faqCategories.length).padStart(2, '0')}</p>
                <h2>{category.title}</h2>
              </div>
              <p>{category.questions.length} {category.questions.length === 1 ? 'question' : 'questions'}</p>
            </header>

            <div class="faq-list">
              {category.questions.map(([question, answer]) => (
                <details class="faq-item">
                  <summary>
                    <strong>{question}</strong>
                    <span aria-hidden="true">+</span>
                  </summary>
                  <div>
                    <p>{answer}</p>
                    {question === 'How much does physical therapy cost?' && (
                      <a class="text-link" href="/concept-01/pricing/">View full pricing <span aria-hidden="true">→</span></a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="home-v3-close faq-v7-close" aria-labelledby="faq-close-title">
  <div class="section-shell home-v3-close__grid">
    <div>
      <p class="eyebrow">STILL HAVE QUESTIONS?</p>
      <h2 id="faq-close-title">We're happy to help.</h2>
      <p>If you don't see your question answered here, reach out and we'll get you the information you need.</p>
      <a class="text-link" href="/concept-01/contact/">Contact Forge <span aria-hidden="true">→</span></a>
    </div>
    <BookingStatus />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-explorer]').forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-faq-category]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-faq-panel]'));
    const tabList = explorer.querySelector<HTMLElement>('[role=\"tablist\"]');
    const compactLayout = window.matchMedia('(max-width: 52rem)');
    const syncOrientation = () => tabList?.setAttribute('aria-orientation', compactLayout.matches ? 'horizontal' : 'vertical');
    syncOrientation();
    compactLayout.addEventListener('change', syncOrientation);

    const selectTab = (nextIndex: number, shouldFocus = false) => {
      tabs.forEach((tab, index) => {
        const isActive = index === nextIndex;
        tab.setAttribute('aria-selected', String(isActive));
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
        if (shouldFocus && isActive) tab.focus();
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index));
      tab.addEventListener('keydown', (event: KeyboardEvent) => {
        let nextIndex = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        selectTab(nextIndex, true);
      });
    });
  });
</script>

<style>
  .faq-v7-hero {
    padding-block: clamp(2.8rem, 4.8vw, 4.6rem);
  }

  .faq-v7-hero h1 {
    font-size: clamp(3.35rem, 5.8vw, 5.9rem);
  }

  .faq-v7-section {
    padding: clamp(2.2rem, 4vw, 3.7rem) 0;
    background: #0b0c0b;
  }

  .faq-explorer {
    display: grid;
    grid-template-columns: minmax(13.5rem, 17rem) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #111311;
  }

  .faq-explorer__categories {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-right: 1px solid var(--line);
    background: #0e100e;
  }

  .faq-explorer__label {
    margin: 0;
    padding: 1rem 1.1rem .8rem;
    color: #6f716b;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
  }

  .faq-explorer__category {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: .65rem;
    align-items: center;
    min-height: 3.9rem;
    padding: .75rem 1rem;
    border: 0;
    border-left: 3px solid transparent;
    border-bottom: 1px solid rgba(255,255,255,.055);
    color: #777a73;
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: color .18s ease, background .18s ease, border-color .18s ease;
  }

  .faq-explorer__category:hover {
    color: #cbc9c2;
    background: rgba(255,255,255,.025);
  }

  .faq-explorer__category[aria-selected='true'] {
    color: var(--ivory);
    border-left-color: var(--gold-bright);
    background: linear-gradient(90deg, rgba(201,154,58,.12), rgba(201,154,58,.025));
  }

  .faq-explorer__category:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: -2px;
  }

  .faq-explorer__category span {
    color: #595b56;
    font: 700 .65rem/1 'Oswald', sans-serif;
  }

  .faq-explorer__category[aria-selected='true'] span {
    color: var(--gold-bright);
  }

  .faq-explorer__category strong {
    font: 700 .72rem/1.25 'Oswald', sans-serif;
    letter-spacing: .02em;
    text-transform: uppercase;
  }

  .faq-explorer__content {
    min-width: 0;
  }

  .faq-explorer__panel {
    min-height: 26rem;
    padding: clamp(1.35rem, 2.5vw, 2rem) clamp(1.25rem, 3vw, 2.4rem);
  }

  .faq-explorer__panel[hidden] {
    display: none;
  }

  .faq-explorer__panel-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .faq-explorer__panel-header h2 {
    max-width: 18ch;
    margin: .25rem 0 0;
    font-size: clamp(1.65rem, 2.7vw, 2.45rem);
    text-transform: uppercase;
  }

  .faq-explorer__panel-header > p {
    flex: 0 0 auto;
    margin: 0 0 .15rem;
    color: #777a73;
    font-size: .68rem;
    font-weight: 700;
  }

  .faq-list {
    border-top: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: .8rem;
    align-items: center;
    min-height: 3.8rem;
    padding: .75rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary strong {
    color: var(--ivory);
    font: 700 clamp(.88rem, 1.3vw, 1.05rem)/1.3 'Oswald', sans-serif;
    text-transform: uppercase;
  }

  .faq-item summary span {
    color: var(--gold-bright);
    font-size: 1.35rem;
    text-align: center;
    transition: transform .18s ease;
  }

  .faq-item[open] summary span { transform: rotate(45deg); }

  .faq-item > div {
    max-width: 48rem;
    padding: 0 2rem 1rem 0;
    color: #aaa9a4;
    font-size: .8rem;
    line-height: 1.65;
  }

  .faq-item > div p { margin: 0 0 .55rem; }

  .faq-v7-close {
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
  }

  @media (max-width: 52rem) {
    .faq-v7-hero {
      padding-block: 2.5rem;
    }

    .faq-v7-hero h1 {
      font-size: clamp(3rem, 12vw, 4.4rem);
    }

    .faq-explorer {
      grid-template-columns: 1fr;
      overflow: visible;
    }

    .faq-explorer__categories {
      flex-direction: row;
      gap: 0;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      scrollbar-width: thin;
    }

    .faq-explorer__label {
      display: none;
    }

    .faq-explorer__category {
      flex: 0 0 min(72vw, 14rem);
      grid-template-columns: 1.7rem minmax(0, 1fr);
      min-height: 3.55rem;
      padding: .7rem .85rem;
      border-left: 0;
      border-bottom: 3px solid transparent;
      border-right: 1px solid var(--line);
      scroll-snap-align: start;
    }

    .faq-explorer__category[aria-selected='true'] {
      border-left-color: transparent;
      border-bottom-color: var(--gold-bright);
      background: linear-gradient(0deg, rgba(201,154,58,.12), rgba(201,154,58,.02));
    }

    .faq-explorer__panel {
      min-height: 0;
      padding: 1.15rem;
    }

    .faq-explorer__panel-header {
      align-items: start;
    }

    .faq-explorer__panel-header h2 {
      font-size: clamp(1.55rem, 7vw, 2rem);
    }

    .faq-item summary {
      min-height: 3.65rem;
      padding: .72rem 0;
    }

    .faq-item > div {
      padding-right: .5rem;
    }
  }
</style>
