---
import { primaryNavigation, type SitePage } from '../../config/navigation';
interface Props { currentPage: SitePage; }
const { currentPage } = Astro.props;
---
<nav class="concept-nav concept-nav--live" data-tone="precision" aria-label="Primary navigation">
  <div class="concept-nav__desktop concept-nav__desktop--live">
    {primaryNavigation.map((item) => <a href={item.href} aria-current={currentPage === item.key ? 'page' : undefined}>{item.label}</a>)}
  </div>
  
  <div class="concept-nav__mobile concept-nav__mobile--live">
    <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-nav-menu" aria-label="Toggle navigation menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <div id="mobile-nav-menu" class="mobile-nav-overlay">
      <div class="mobile-nav-overlay__inner">
        {primaryNavigation.map((item) => <a href={item.href} aria-current={currentPage === item.key ? 'page' : undefined}>{item.label}</a>)}
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    
    if (toggleBtn && mobileMenu) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        
        if (!isExpanded) {
          mobileMenu.classList.add('is-open');
          document.body.style.overflow = 'hidden'; // Lock scroll
        } else {
          mobileMenu.classList.remove('is-open');
          document.body.style.overflow = ''; // Unlock scroll
        }
      });
    }
  });
</script>

<style>
  .concept-nav {
    position: relative;
  }
  
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 100;
    position: relative;
  }
  
  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--muted, #999a94);
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }
  
  .mobile-menu-toggle:hover .hamburger-line {
    background-color: var(--ivory, #fff);
  }
  
  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  
  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  
  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(11, 12, 11, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 90;
  }

  .mobile-nav-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-overlay__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }

  .mobile-nav-overlay__inner a {
    color: var(--text-faint, #6f716b);
    text-decoration: none;
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    /* On close, hold position and opacity for 0.3s while the parent fades out, then reset instantly */
    transition: color 0.2s ease, transform 0s linear 0.3s, opacity 0s linear 0.3s;
    transform: translateY(20px);
    opacity: 0;
  }
  
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a {
    transform: translateY(0);
    opacity: 1;
    /* On open, animate smoothly */
    transition: color 0.2s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  
  /* Staggered entrance animation for links */
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(1) { transition-delay: 0.03s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(2) { transition-delay: 0.06s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(3) { transition-delay: 0.09s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(4) { transition-delay: 0.12s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(5) { transition-delay: 0.15s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(6) { transition-delay: 0.18s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(7) { transition-delay: 0.21s; }
  .mobile-nav-overlay.is-open .mobile-nav-overlay__inner a:nth-child(8) { transition-delay: 0.24s; }
  
  .mobile-nav-overlay__inner a:hover {
    color: var(--ivory, #fff);
  }

  .mobile-nav-overlay__inner a[aria-current="page"] {
    color: var(--ivory, #fff);
    position: relative;
  }
  
  .mobile-nav-overlay__inner a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: var(--gold-bright, #dda947);
    border-radius: 50%;
  }
</style>
