---
import { primaryNavigation } from '../../config/navigation';
import { siteConfig } from '../../config/site';
const contact = siteConfig.contact;
---
<footer class="site-footer site-footer--complete">
  <div class="footer-brand">
    <a class="brand brand--footer" href={`${siteConfig.basePath}/`} aria-label={`${siteConfig.accessibleName} home`}>
      <img src={siteConfig.logo} alt="" width="1280" height="1280" loading="lazy" decoding="async" />
      <span>{siteConfig.shortName} <small>Rehab &amp; Performance</small></span>
    </a>
    <p>Recover. <b>Build.</b> Perform.</p>
  </div>
  <div class="footer-directory">
    <nav aria-label="Footer navigation">
      <h2>Explore</h2>
      {primaryNavigation.map((item) => <a href={item.href}>{item.key === 'approach' ? 'Forge Approach' : item.label}</a>)}
    </nav>
    <div>
      <h2>Contact</h2>
      <p>{contact.phone ?? 'Phone coming soon'}</p>
      <p>{contact.email ?? 'Email coming soon'}</p>
      <p>{contact.address ?? 'Location coming soon'}</p>
      <p>{siteConfig.booking.url ? 'Online scheduling available' : 'Online scheduling coming soon'}</p>
    </div>
    <div>
      <h2>Care model</h2>
      <p>{siteConfig.description}</p>
      <p>{siteConfig.practitioner.name}, {siteConfig.practitioner.credentials}</p>
    </div>
  </div>
  <div class="image-credits" role="region" aria-labelledby="image-credits-title">
    <h2 id="image-credits-title">Demo image credits</h2>
    <p>Stock images are licensed demo imagery and do not depict Forge patients, clinicians, facilities, treatment, or outcomes.</p>
    <ul>
      <li><a href="https://commons.wikimedia.org/wiki/User:Indylala">Indylala</a>, <a href="https://commons.wikimedia.org/wiki/File:Luis_Morales_(athlete)_running_in_college.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
      <li><a href="https://commons.wikimedia.org/wiki/User:RickyBennison">RickyBennison</a>, <a href="https://commons.wikimedia.org/wiki/File:Unilateral_barbell_back_squat_squatting.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
      <li><a href="https://commons.wikimedia.org/wiki/User:Sunnyjoe035">Sunnyjoe035</a>, <a href="https://commons.wikimedia.org/wiki/File:A_Basketball_Player.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
    </ul>
  </div>
  <div class="footer-meta">
    <p>© 2026 {siteConfig.name}. All Rights Reserved.</p>
    <p>Privacy Policy · Notice of Privacy Practices · Production documents to be added before launch</p>
  </div>
</footer>
