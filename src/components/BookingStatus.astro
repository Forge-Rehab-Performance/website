---
import { siteConfig } from '../config/site';
const bookingUrl = siteConfig.booking.url;
---
<div class="booking-status">
  {bookingUrl ? (
    <a class="btn-primary booking-link" href={bookingUrl}>Book an Evaluation</a>
  ) : (
    <a class="btn-primary booking-link" href="/concept-01/contact/">Get notified when scheduling opens &rarr;</a>
  )}
  <span>{bookingUrl ? 'Online scheduling available' : 'Online scheduling coming soon'}</span>
</div>
