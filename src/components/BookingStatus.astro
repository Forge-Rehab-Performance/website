---
import { siteConfig } from '../config/site';

interface Props {
  hideAvailability?: boolean;
}

const { hideAvailability = false } = Astro.props;
const bookingUrl = siteConfig.booking.url;
---
<div class="booking-status">
  {bookingUrl ? (
    <a class="btn-primary booking-link" href={bookingUrl}>Schedule a Visit</a>
  ) : (
    <a class="btn-primary booking-link" href="/contact/">Get notified when scheduling opens &rarr;</a>
  )}
  {(!bookingUrl || !hideAvailability) && (
    <span>{bookingUrl ? 'Online scheduling available' : 'Online scheduling coming soon'}</span>
  )}
</div>
