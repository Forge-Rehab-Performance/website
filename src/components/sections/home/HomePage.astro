---
import BookingStatus from '../../BookingStatus.astro';
import { Image } from 'astro:assets';
import heroStrengthImg from '../../../assets/hero_strength.jpg';
import familyImg from '../../../assets/home-family.webp';
import kettlebellImg from '../../../assets/home-kettlebell.webp';
import heroRehabImg from '../../../assets/hero_rehabilitation.jpg';
---

<div class="section-shell home-scheduling"><BookingStatus /></div>

<section class="home-hero" aria-labelledby="hero-title">
    <div class="section-shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">FORGE REHAB &amp; PERFORMANCE</p>
        <h1 id="hero-title">Rehabilitation<br /><span>built around</span> your goals.</h1>
        <p class="hero-lede">One-on-one physical therapy for active people who expect more from their recovery.</p>
      </div>

      <figure class="home-hero__media">
        <Image src={heroStrengthImg} alt="A person performs a single-leg barbell back squat" fetchpriority="high" />
        <figcaption>Licensed demo stock. Does not depict Forge people, facilities, treatment, or outcomes.</figcaption>
      </figure>
    </div>

  </section>

  <section class="home-problem" aria-labelledby="problem-title">
    <div class="section-shell home-problem__grid">
      <header>
        <p class="eyebrow">THE PROBLEM</p>
        <h2 id="problem-title">You don't just want to feel better.</h2>
        <p>Feeling better is only the beginning. Your rehabilitation should be designed around where you want to go—not just where you are today.</p>
      </header>
      <ul aria-label="What people want to get back to">
        <li><strong>Run again.</strong></li>
        <li><strong>Lift again.</strong></li>
        <li><strong>Play with your kids.</strong></li>
        <li><strong>Get back on the field.</strong></li>
        <li><strong>Train without constantly worrying about your injury.</strong></li>
        <li class="home-problem__accent"><span>→</span><strong>Build toward what comes next.</strong></li>
      </ul>
    </div>
  </section>

  <section class="home-approach" aria-labelledby="approach-title">
    <div class="section-shell">
      <header class="home-section-heading">
        <div><p class="eyebrow">THE FORGE APPROACH</p><h2 id="approach-title">Three stages to full capacity.</h2></div>
        <div><p>Rehabilitation shouldn't just get you back to normal. It should prepare you for what's next.</p><a class="text-link" href="/approach/">Explore the Forge Approach <span aria-hidden="true">→</span></a></div>
      </header>
      <ol class="home-approach__stages">
        <li><span>01</span><div><h3>Recover</h3><p>Reduce pain. Restore movement. Understand what's causing the problem.</p></div></li>
        <li><span>02</span><div><h3>Build</h3><p>Build strength, stability, and physical capacity through progressive rehabilitation.</p></div></li>
        <li><span>03</span><div><h3>Perform</h3><p>Return to the activities, sports, and training that matter to you—with confidence.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="home-audiences surface-light" aria-labelledby="audiences-title">
    <div class="section-shell">
      <header class="home-audiences__heading">
        <div><p class="eyebrow">WHO IT'S FOR</p><h2 id="audiences-title">Built for people who want to keep moving.</h2></div>
        <p>If staying active matters to you, you're in the right place.</p>
      </header>
      <div class="home-audiences__grid">
        <figure class="home-audience-feature">
          <Image src={familyImg} alt="A family plays together with a flying disc in a sunny yard" loading="lazy" />
          <figcaption>Stock photography.</figcaption>
          <div class="home-audience-feature__labels">
            <article><h3>Active Adults</h3><p>Whether you're walking the dog, chasing kids, or gardening, stay pain-free in your daily life.</p></article>
            <article><h3>Weekend Warriors</h3><p>Run. Lift. Golf. Ski. Play. Don't let injury dictate your weekends.</p></article>
          </div>
        </figure>
        <figure class="home-audience-feature">
          <Image src={kettlebellImg} alt="A person lifts a yellow kettlebell during a gym workout" loading="lazy" />
          <figcaption>Stock photography.</figcaption>
          <div class="home-audience-feature__labels">
            <article><h3>Athletes</h3><p>Return to your sport prepared for the demands of competition.</p></article>
            <article><h3>Strength &amp; Fitness Enthusiasts</h3><p>Keep training in the gym, lifting, or taking classes without working around pain.</p></article>
          </div>
        </figure>
      </div>
      <p class="stock-disclosure">Imagery does not depict Forge people, patients, clinicians, facilities, treatment, or outcomes.</p>
    </div>
  </section>

  <section class="home-services" aria-labelledby="services-title">
    <div class="section-shell home-services__grid">
      <header>
        <p class="eyebrow">SERVICES</p>
        <h2 id="services-title">From injury to performance.</h2>
        <p>Individualized care designed around your goals—from injury and surgery recovery through return to sport, activity, strength, and performance.</p>
        <a class="text-link" href="/services/">Explore Services <span aria-hidden="true">→</span></a>
      </header>
      <ul class="home-services__list" aria-label="Forge services">
        <li><div><h3>Orthopedic Physical Therapy</h3><p>Expert care built around the way you move and the activities that matter to you.</p></div></li>
        <li><div><h3>Sports &amp; Injury Rehabilitation</h3><p>Progress from symptom reduction toward the specific demands of sport and training.</p></div></li>
        <li><div><h3>Post-Operative Rehabilitation</h3><p>Progressive rehabilitation aligned with your procedure, recovery, and goals.</p></div></li>
        <li><div><h3>Return to Sport &amp; Activity</h3><p>Bridge the gap between rehab exercises and the demands of real life.</p></div></li>
        <li><div><h3>Strength &amp; Performance</h3><p>Build physical capacity, move better, and train around previous injuries.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="home-brandon" aria-labelledby="brandon-title">
    <div class="section-shell home-brandon__grid">
      <div class="home-brandon__mark" aria-hidden="true"><Image src={heroRehabImg} alt="" loading="lazy" /></div>
      <div class="home-brandon__copy">
        <p class="eyebrow">MEET BRANDON</p>
        <h2 id="brandon-title">Expertise. Experience. Personalized care.</h2>
        <h3>Brandon Coveney, PT, DPT, OCS</h3>
        <p class="credential-line">Board-Certified Orthopedic Clinical Specialist</p>
        <p>After 8+ years in outpatient orthopedic physical therapy, Brandon created Forge Rehab &amp; Performance to provide a different kind of rehabilitation experience—one built around individualized care, clinical expertise, and progressive strength training.</p>
        <dl>
          <div><dt>Credentials</dt><dd>PT, DPT, OCS</dd></div>
          <div><dt>Education</dt><dd>Sacred Heart University · DPT, 2018</dd></div>
          <div><dt>Care model</dt><dd>One-on-one · Evidence-based · Progressive</dd></div>
        </dl>
        <a class="text-link" href="/about/">Meet Brandon <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-close" aria-labelledby="final-title">
    <div class="section-shell home-close__grid">
      <div><p class="eyebrow">YOUR NEXT STEP</p><h2 id="final-title">Ready to get back to what you love?</h2><p>You don't have to settle for simply feeling better. Take the next step toward your goals.</p></div>
      <BookingStatus />
    </div>
  </section>

<style>
  .home-scheduling {
    display: flex;
    justify-content: flex-end;
    padding-block: 1.25rem;
  }

  @media (max-width: 52rem) {
    .home-scheduling { justify-content: flex-start; }
  }
</style>
