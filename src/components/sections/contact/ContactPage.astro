---
import BookingStatus from '../../BookingStatus.astro';
import { siteConfig } from '../../../config/site';
const contact = siteConfig.contact;
const mapQuery = encodeURIComponent(`${contact.gymName ?? ''} ${contact.address ?? ''}`);
---

<section class="inner-hero" aria-labelledby="contact-title"><div class="section-shell inner-hero__grid"><div><p class="eyebrow">CONTACT</p><h1 id="contact-title">Let's get<br /><span>you moving.</span></h1></div><div class="inner-hero__aside"><p class="hero-lede">Have a question about physical therapy, your recovery, or whether Forge is the right fit for you? We're here to help.</p><p>If you're ready to get started, the fastest way is to book an evaluation.</p><BookingStatus /></div></div></section>

  <section class="contact-main surface-light" aria-labelledby="contact-form-title"><div class="section-shell contact-main__grid">
    <div class="contact-form-copy"><p class="eyebrow">HAVE A QUESTION?</p><h2 id="contact-form-title">We'd love to hear from you.</h2><p>Whether you're not sure where to start, have a question about services, or want to learn more about how Forge works, send us a message.</p><p class="contact-privacy">Please do not include sensitive medical information in this form.</p></div>
    <contact-form>
      <form class="contact-form" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" data-astro-reload aria-label="Contact Forge form">
        <label>Name<input type="text" name="name" autocomplete="name" placeholder="Your Name" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" placeholder="Your Email" required /></label>
        <label>Phone<input type="tel" name="phone" autocomplete="tel" placeholder="Your Phone" /></label>
        <label class="contact-form__full">What can we help you with?<select name="interest"><option value="">Select an option</option><option>I'm interested in physical therapy</option><option>I'm recovering from surgery</option><option>I'm interested in sports rehabilitation</option><option>I'm interested in strength &amp; performance</option><option>I have a question about pricing</option><option>I'm not sure if Forge is right for me</option><option>Other</option></select></label>
        <label class="contact-form__full">Message<textarea name="message" rows="6" placeholder="Tell us a little about what you're looking for" required></textarea></label>
        <div class="contact-form__full contact-form__submit"><button type="submit">Send Message</button><span>Your information is secure and will only be used to contact you regarding your inquiry.</span></div>
      </form>
    </contact-form>

    <script src="../../../scripts/contact-form.ts"></script>
  </div></section>

  <section class="contact-direct" aria-labelledby="direct-title"><div class="section-shell"><header class="interior-heading"><div><p class="eyebrow">PREFER TO REACH OUT DIRECTLY?</p><h2 id="direct-title">Choose the way that works for you.</h2></div><p>Call or email Forge, or visit us inside {contact.gymName}. Contact us for current availability.</p></header><div class="contact-cards"><article><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold-bright)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg><h3>Phone</h3><p>{contact.phone ? <a href={`tel:${contact.phone.replace(/\D/g, '')}`}>{contact.phone}</a> : 'Phone coming soon'}</p></article><article><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold-bright)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg><h3>Email</h3><p>{contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : 'Email coming soon'}</p></article><article><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold-bright)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg><h3>Location</h3><p>{siteConfig.name}</p><p>Inside {contact.gymName ?? 'partner gym'}</p><p>{contact.address ?? 'Address coming soon'}</p></article><article><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold-bright)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg><h3>Hours</h3><p>{contact.hours ?? 'Contact us for current hours'}</p></article></div></div></section>

  <section class="contact-location surface-light" aria-labelledby="location-title"><div class="section-shell contact-location__grid"><div><p class="eyebrow">VISIT FORGE</p><h2 id="location-title">Your rehab. Your training environment.</h2><p>{siteConfig.name} is located inside {contact.gymName}, giving you access to a real training environment where rehabilitation can progress naturally from recovery to strength and performance.</p><p>{contact.address}</p><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}>Get directions <span aria-hidden="true">→</span></a></div><div class="map-embed-wrapper" aria-label="Map location"><iframe src={`https://maps.google.com/maps?q=${mapQuery}&output=embed`} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Google Map location for ${siteConfig.name} inside ${contact.gymName}`}></iframe></div></div></section>

  <section class="home-close" aria-labelledby="contact-close-title"><div class="section-shell home-close__grid"><div><p class="eyebrow">NOT SURE IF FORGE IS RIGHT FOR YOU?</p><h2 id="contact-close-title">That's okay.</h2><p>You don't need to know exactly what service you need before reaching out. Start with a conversation or book an evaluation, and we'll figure out the right next step together.</p></div><BookingStatus /></div></section>

<style>
.contact-main__grid {
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: clamp(3rem, 7vw, 7rem);
  align-items: start;
}

.contact-form-copy h2 {
  max-width: 10ch;
}

.contact-form-copy>p:not(.eyebrow):not(.contact-privacy) {
  max-width: 30rem;
  color: #555752;
}

.contact-privacy {
  max-width: 30rem;
  margin-top: 2rem;
  padding: 1rem;
  border-left: 2px solid #956b17;
  color: #333531;
  font-size: .74rem;
  font-weight: 700;
}

.contact-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.contact-form label {
  display: grid;
  gap: .5rem;
  color: #333531;
  font-size: .66rem;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
  width: 100%;
  padding: .9rem 1rem;
  border: 1px solid #cbc7bd;
  border-radius: var(--radius);
  color: #1d1f1c;
  background: #f8f6f0;
  font: inherit;
  font-size: .82rem;
  text-transform: none;
}

.contact-form textarea {
  resize: vertical;
}

.contact-form__full {
  grid-column: 1 / -1;
}

.contact-form__submit {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
}

.contact-form__submit button {
  min-height: 48px;
  padding: .85rem 1.3rem;
  border: 1px solid #8a6317;
  border-radius: var(--radius);
  color: #f7f3e9;
  background: #1b1d1a;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
}

.contact-form__submit span {
  color: #6a6c67;
  font-size: .68rem;
}

.contact-direct {
  padding: clamp(4rem, 6vw, 5.5rem) 0;
  background: #111311;
  border-block: 1px solid var(--line);
}

.contact-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--line);
}

.contact-cards article {
  padding: 2.4rem 1.7rem;
  border-right: 1px solid var(--line);
}

.contact-cards article:last-child {
  border-right: none;
}

.contact-icon {
  margin-bottom: 1.25rem;
}

.contact-cards h3 {
  margin: 0 0 .6rem;
  font-size: 1.25rem;
}

.contact-cards p {
  margin: 0;
  color: #9e9c96;
  font-size: .8rem;
}

.contact-location__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3.5rem, 6vw, 5rem) 0;
}

.contact-location__placeholder {
  max-width: 30rem;
  margin-top: 1.2rem;
  padding: 1rem;
  border-left: 2px solid #d4cca6;
  background: #eeebe1;
  color: #615c44;
  font-size: .74rem;
  font-weight: 700;
}

.map-embed-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 75%;
  background: #e6e3d8;
  border-radius: var(--radius);
  overflow: hidden;
}

.map-embed-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

@media (max-width: 78rem) {
  .contact-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact-cards article:nth-child(2) {
    border-right: none;
  }

  .contact-cards article:nth-child(-n+2) {
    border-bottom: 1px solid var(--line);
  }
}

@media (max-width: 52rem) {
  .contact-main__grid,
  .contact-location__grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 34rem) {
  .contact-cards,
  .contact-form {
    grid-template-columns: 1fr;
  }

  .contact-form__full {
    grid-column: auto;
  }

  .contact-cards article {
    border-right: none;
  }

  .contact-cards article:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }
}
</style>
