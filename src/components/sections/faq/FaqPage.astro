---
import BookingStatus from '../../BookingStatus.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../config/site';

const { booking, contact } = siteConfig;
const phone = contact.phone?.replace(/\D/g, '');
const faqEntries = await getCollection('faq');
const faqCategories = faqEntries.map(entry => entry.data).sort((a, b) => a.order - b.order);
---

<section class="inner-hero faq-hero" aria-labelledby="faq-title">
  <div class="section-shell inner-hero__grid">
    <div>
      <p class="eyebrow">FAQ</p>
      <h1 id="faq-title">Your questions,<br /><span>answered.</span></h1>
    </div>
    <div class="inner-hero__aside">
      <p class="hero-lede">Everything you need to know about one-on-one care at Forge, pricing, insurance, the gym setting, and getting started.</p>
    </div>
  </div>
</section><section class="faq-directory">
  <div class="section-shell">
    <div class="faq-directory__grid">
      <!-- Left Sidebar -->
      <div class="faq-sidebar mobile-jump-menu">
        <button type="button" class="mobile-jump-menu__summary" id="faq-jump-toggle" aria-expanded="false" aria-controls="faq-jump-nav">
          <span class="mobile-jump-menu__active-text" data-jump-text>Jump to section...</span>
          <span class="mobile-jump-menu__icon" aria-hidden="true">↓</span>
        </button>
        <nav id="faq-jump-nav" aria-label="FAQ Categories">
          <ul class="faq-sidebar__list">
            {faqCategories.map((category) => (
              <li>
                <a href={`#faq-category-${category.id}`} data-scroll-spy-link={`faq-category-${category.id}`} class="faq-sidebar__link">
                  {category.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Right Content -->
      <div class="faq-content">
        {faqCategories.map((category) => (
          <section id={`faq-category-${category.id}`} class="faq-category-section">
            <h2>{category.title}</h2>
            <div class="faq-list">
              {category.questions.map(([question, answer]) => (
                <details class="faq-item">
                  <summary>
                    <strong>{question}</strong>
                    <span aria-hidden="true">+</span>
                  </summary>
                  <div>
                    {question === 'How do I schedule an appointment?' && booking.url && (
                      <p><a class="text-link" href={booking.url}>Schedule a Visit <span aria-hidden="true">→</span></a></p>
                    )}
                    {answer.split('\n\n').map(paragraph => {
                      if (paragraph.trim().startsWith('- ')) {
                        return (
                          <ul class="faq-bullet-list">
                            {paragraph.split('\n').map(item => (
                              <li set:html={item.replace(/^- /, '')} />
                            ))}
                          </ul>
                        );
                      }
                      return <p set:html={paragraph} />;
                    })}
                    {question === 'How do I schedule an appointment?' && phone && (
                      <p>Need help? <a href={`tel:${phone}`}>Call</a> or <a href={`sms:${phone}`}>text</a> us at {contact.phone}.</p>
                    )}
                    {question === 'How much does physical therapy cost?' && (
                      <a class="text-link" href="/pricing/">View full pricing <span aria-hidden="true">→</span></a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="home-close faq-close" aria-labelledby="faq-close-title">
  <div class="section-shell home-close__grid">
    <div>
      <p class="eyebrow">STILL HAVE QUESTIONS?</p>
      <h2 id="faq-close-title">We're happy to help.</h2>
      <p>If you don't see your question answered here, reach out and we'll get you the information you need.</p>
      <a class="text-link" href="/contact/">Contact Forge <span aria-hidden="true">→</span></a>
    </div>
    <BookingStatus />
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -80% 0px',
      threshold: 0
    };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        document.querySelectorAll('[data-scroll-spy-link]').forEach(link => {
          if (link.getAttribute('data-scroll-spy-link') === id) {
            link.classList.add('is-active');
            // Update mobile summary text
            const jumpText = document.querySelector('[data-jump-text]');
            if (jumpText) {
              jumpText.textContent = link.textContent;
            }
          } else {
            link.classList.remove('is-active');
          }
        });
      }
    });
  }, observerOptions);

  document.querySelectorAll('section[id^="faq-category-"]').forEach(section => {
    observer.observe(section);
  });

  document.querySelectorAll('[data-scroll-spy-link]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href');
      if (!targetId) return;
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
        // Close menu on mobile
        const menu = link.closest('.mobile-jump-menu');
        if (menu) {
          menu.classList.remove('is-open');
          const toggle = menu.querySelector('#faq-jump-toggle');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }
      }
    });
  });

  const jumpToggle = document.getElementById('faq-jump-toggle');
  if (jumpToggle) {
    jumpToggle.addEventListener('click', () => {
      const menu = jumpToggle.closest('.mobile-jump-menu');
      if (menu) {
        const isOpen = menu.classList.toggle('is-open');
        jumpToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
    });
  }
  });
</script>

<style>
  .faq-hero {
    padding-block: clamp(2.8rem, 4.8vw, 4.6rem);
  }

  .faq-hero h1 {
    font-size: clamp(3.35rem, 5.8vw, 5.9rem);
  }

  .faq-directory {
    padding: clamp(2.2rem, 4vw, 3.7rem) 0;
    background: #0b0c0b;
  }

  .faq-directory__grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 4rem;
  }

  .faq-sidebar {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .faq-sidebar nav {
    display: block;
  }

  .mobile-jump-menu__summary {
    display: none;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    padding: 0;
  }

  .faq-sidebar__list {
    list-style: none;
    padding: 0 0 0 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-left: 1px solid var(--line);
  }

  .faq-sidebar__link {
    display: block;
    color: var(--text-faint, #6f716b);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    position: relative;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .faq-sidebar__link:hover {
    color: var(--gold-bright, #dda947);
  }

  .faq-sidebar__link.is-active {
    color: var(--ivory, #fff);
    transform: translateX(4px);
  }

  .faq-sidebar__link::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gold-bright, #dda947);
    transform: scaleY(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .faq-sidebar__link.is-active::before {
    transform: scaleY(1);
  }

  .faq-content {
    min-width: 0;
  }

  .faq-category-section {
    padding-bottom: 5rem;
  }

  .faq-category-section:last-child {
    padding-bottom: 0;
  }

  .faq-category-section h2 {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--ivory);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    margin-bottom: 2rem;
    margin-top: 0;
  }

  .faq-list {
    border-top: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: .8rem;
    align-items: center;
    min-height: 3.8rem;
    padding: .75rem 1rem;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }
  
  .faq-item summary:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary strong {
    color: var(--ivory);
    font: 700 clamp(.88rem, 1.3vw, 1.05rem)/1.3 'Oswald', sans-serif;
    text-transform: uppercase;
  }

  .faq-item summary span {
    color: var(--gold-bright);
    font-size: 1.35rem;
    text-align: center;
    transition: transform .18s ease;
  }

  .faq-item[open] summary span { transform: rotate(45deg); }

  .faq-item > div {
    max-width: 48rem;
    padding: 0 2rem 1rem 1rem;
    color: var(--text-dim);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .faq-item > div .text-link { font-size: 1rem; }
  .faq-item > div p, .faq-bullet-list { margin: 0 0 .55rem; }
  .faq-bullet-list { padding-left: 1.25rem; }
  .faq-bullet-list li { margin-bottom: .25rem; }

  .faq-close {
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
  }

  @media (max-width: 52rem) {
    .faq-hero {
      padding-block: 2.5rem;
    }

    .faq-hero h1 {
      font-size: clamp(3rem, 12vw, 4.4rem);
    }

    .faq-directory__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .faq-sidebar {
      display: block;
      position: sticky;
      top: 0;
      z-index: 20;
      padding: 0;
      margin-inline: -1rem;
    }

    .faq-sidebar:not(.is-open) nav {
      /* Handled by opacity/visibility now */
    }

    .mobile-jump-menu__summary {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.25rem;
      background: rgba(11, 12, 11, 0.85); /* Frosted --black */
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--ivory, #fff);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .faq-sidebar.is-open .mobile-jump-menu__summary {
      background: var(--black, #0b0c0b);
      border-bottom-color: transparent;
    }

    .mobile-jump-menu__summary::-webkit-details-marker {
      display: none;
    }

    .faq-sidebar.is-open .mobile-jump-menu__icon {
      transform: rotate(180deg);
    }
    
    .mobile-jump-menu__icon {
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      color: var(--gold-bright, #dda947);
    }

    .faq-sidebar nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--black, #0b0c0b);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 1.25rem 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
      
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .faq-sidebar.is-open nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .faq-sidebar__list {
      flex-direction: column;
      gap: 1rem;
    }

    .faq-sidebar__link {
      white-space: normal;
      padding: 0.5rem 0;
    }
    
    .faq-category-section {
      padding-bottom: 3rem;
    }

    .faq-item summary {
      min-height: 3.65rem;
      padding: .72rem 0;
    }

    .faq-item > div {
      padding-right: .5rem;
      padding-left: 0;
    }
  }
</style>
