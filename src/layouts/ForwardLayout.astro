---
import ConceptNav from '../components/ConceptNav.astro';
import '../styles/forward.css';

interface Props {
  title: string;
  description: string;
  currentPage: 'home' | 'approach';
  showImageCredits?: boolean;
}

const { title, description, currentPage, showImageCredits = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    <link rel="preload" href="/assets/oswald-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: Training Culture connects clinical reasoning to the demands of an active life.
      OWN-WORLD: Near-black, off-white, electric lime, condensed statements, directional rules, and decisive documentary crops.
      STORY: Recognize your pursuit, understand Recover / Build / Perform, meet Brandon, then explore the approach.
      FIRST VIEWPORT: Two runners at starting blocks frame a compact training-culture statement and honest disabled action.
      FORM: Training Culture, approved bold direction; seed key: task-6-approved-brief.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="forward-header">
      <a class="forward-brand" href="/concept-03" aria-label="Forge Rehab and Performance home">
        <img src="/assets/forge-logo.png" width="84" height="84" alt="" />
        <span>Forge Rehab <b>&amp;</b> Performance</span>
      </a>
      <ConceptNav conceptId="concept-03" currentPage={currentPage} tone="lime" />
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      {showImageCredits && (
        <div class="image-credits" role="region" aria-labelledby="image-credits-title">
          <h2 id="image-credits-title">Demo image credits</h2>
          <p>Stock images are licensed demo imagery and do not depict Forge people or patients, clinicians or staff, facilities, treatment, or outcomes.</p>
          <ul>
            <li><a href="https://commons.wikimedia.org/wiki/User:Indylala">Indylala</a>, <a href="https://commons.wikimedia.org/wiki/File:Luis_Morales_(athlete)_running_in_college.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
            <li><a href="https://commons.wikimedia.org/wiki/User:RickyBennison">RickyBennison</a>, <a href="https://commons.wikimedia.org/wiki/File:Unilateral_barbell_back_squat_squatting.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
            <li><a href="https://commons.wikimedia.org/wiki/User:Sunnyjoe035">Sunnyjoe035</a>, <a href="https://commons.wikimedia.org/wiki/File:A_Basketball_Player.jpg">Source</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; cropped/resized and converted to WebP for this demo.</li>
          </ul>
        </div>
      )}
      <div class="footer-mark"><strong>Forge Rehab &amp; Performance</strong><span>Northern New Jersey</span></div>
    </footer>
  </body>
</html>
