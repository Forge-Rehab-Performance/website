---
import BookingStatus from '../../components/BookingStatus.astro';
import ForwardLayout from '../../layouts/ForwardLayout.astro';

const audiences = [
  ['Athletes', 'Build back toward the speed, change of direction, and repeat effort your sport asks of you.'],
  ['Lifters', 'Progress strength, control, and tolerance around the lifts and training you want to return to.'],
  ['Weekend warriors', 'Prepare for the runs, leagues, trails, and sessions that compete with a full week.'],
  ['Active adults', 'Develop capacity for work, family, recreation, and the activities that keep life moving.']
];

const stages = [
  ['01', 'Recover', 'Begin with evaluation and understanding. Address symptoms and establish a foundation.'],
  ['02', 'Build', 'Develop strength, mobility, control, capacity, and confidence around your individual goals.'],
  ['03', 'Perform', 'Progress toward the demands of your chosen activities without a one-size-fits-all benchmark.']
];
---

<ForwardLayout title="Training Culture | Forge Rehab & Performance" description="One-on-one, progressive physical therapy for active adults in Northern New Jersey." currentPage="home" showImageCredits>
  <section class="culture-hero" aria-labelledby="culture-title">
    <img src="/assets/forward-movement.webp" width="714" height="960" alt="Two runners stand at starting blocks on an outdoor track" />
    <div class="culture-hero__copy">
      <p class="culture-kicker">Rehab for a life in motion</p>
      <h1 id="culture-title">Recovery is the start. <em>Train forward.</em></h1>
      <p>One-on-one, evidence-based physical therapy that progresses beyond symptom reduction toward the demands of what you want to do.</p>
      <div class="actions"><BookingStatus /><a href="/concept-03/approach/">Explore the Forge Approach</a></div>
    </div>
    <p class="stock-note">Licensed demo stock. Does not depict Forge people or patients, clinicians or staff, facilities, treatment, or outcomes.</p>
  </section>

  <section class="culture-proof" aria-labelledby="proof-title">
    <p class="culture-kicker">Built for the next demand</p>
    <h2 id="proof-title">Your goal has a life outside the clinic.</h2>
    <p>Forge is built for people whose goals reach into training, sport, work, family, and the activities that matter to them. Care connects the clinical starting point to the real demands ahead.</p>
    <ul><li>One-on-one care</li><li>Individual goals</li><li>Progressive preparation</li></ul>
  </section>

  <section class="audience-cards" aria-labelledby="audience-title">
    <div class="section-heading"><p class="culture-kicker">Who this is for</p><h2 id="audience-title">Different pursuits. The same need to be ready.</h2></div>
    <ul>
      {audiences.map(([name, description], index) => <li><span>0{index + 1}</span><h3>{name}</h3><p>{description}</p></li>)}
    </ul>
  </section>

  <section class="culture-process" aria-labelledby="process-title">
    <div class="culture-process__intro"><p class="culture-kicker">The progression</p><h2 id="process-title">Recover. Build. Perform.</h2><p>Three stages keep the work connected to the person and the goal, not a rigid timeline.</p></div>
    <figure><img src="/assets/forward-strength.webp" width="379" height="446" loading="lazy" decoding="async" alt="A person performs a single-leg barbell back squat" /><figcaption>Licensed demo stock. Does not depict Forge people or patients, clinicians or staff, facilities, treatment, or outcomes.</figcaption></figure>
    <ol>
      {stages.map(([number, name, description]) => <li><span>{number}</span><h3>{name}</h3><p>{description}</p></li>)}
    </ol>
  </section>

  <section class="culture-evidence" aria-labelledby="evidence-title">
    <figure><img src="/assets/forward-court.webp" width="1600" height="1200" loading="lazy" decoding="async" alt="A basketball player moves with the ball on an outdoor court" /><figcaption>Licensed demo stock. Does not depict Forge people or patients, clinicians or staff, facilities, treatment, or outcomes.</figcaption></figure>
    <div><p class="culture-kicker">Clinical reasoning, personal direction</p><h2 id="evidence-title">Built around the person in front of you.</h2><p>Brandon Coveney, PT, DPT, OCS is an orthopedic physical therapist and a 2018 graduate of Sacred Heart University's Doctor of Physical Therapy program, with ties to Northern New Jersey.</p><p>Forge's care is one-on-one, progressive, and grounded in individual goals.</p></div>
  </section>

  <section class="forward-close" aria-labelledby="close-title">
    <p class="culture-kicker">Keep building</p><h2 id="close-title">Your goal sets the direction.</h2>
    <p>Read the full approach now. Evaluation booking will open only when a real scheduling destination is ready.</p>
    <div class="actions"><a href="/concept-03/approach/">Explore the Forge Approach</a><BookingStatus /></div>
  </section>
</ForwardLayout>
