import BookingStatus from '../../components/BookingStatus.astro';
import BlueprintLayout from '../../layouts/BlueprintLayout.astro';
---

<BlueprintLayout title="The Forge Approach | Performance Journal" description="A field journal of Forge Rehab & Performance's Recover, Build, Perform progression." currentPage="approach">
  <header class="guide-hero">
    <div class="margin-note"><span>Field journal / 01–08</span><p>A plain-language account of how Forge thinks about progressive care.</p></div>
    <div class="guide-hero__body"><p class="folio">The Forge Approach</p><h1>Recover. Build. Perform.</h1><p class="lede">Three stages, adapted around individual goals and delivered through one-on-one care.</p><a class="text-link" href="#chapter-01">Begin reading</a></div>
  </header>

  <nav class="guide-index" aria-label="Approach chapters"><a href="#chapter-01">01 Premise</a><a href="#chapter-02">02 Recover</a><a href="#chapter-03">03 Build</a><a href="#chapter-04">04 Perform</a><a href="#chapter-05">05 Individualized</a><a href="#chapter-06">06 One-on-one</a><a href="#chapter-07">07 Build Forward</a><a href="#chapter-08">08 Next step</a></nav>

  <div class="guide-journal">
    <section id="chapter-01" class="guide-module" aria-labelledby="premise-title">
      <div class="margin-note"><span>Orientation</span><p>Capacity follows the foundation.</p></div>
      <article class="guide-module__body"><p class="guide-folio"><span>01</span>Premise</p><h2 id="premise-title">Capacity begins with a foundation.</h2><p>Recovery can reduce symptoms and establish a base. Forge treats that work as the starting point for developing the capacity needed for individual goals and chosen activities.</p></article>
    </section>

    <section class="guide-module" aria-labelledby="sequence-title">
      <div class="margin-note"><span>Assessment to progression</span><p>Evaluation and understanding come first. Each stage prepares for what follows.</p></div>
      <div class="guide-module__body"><h2 id="sequence-title">From understanding to real demands.</h2><div class="guide-sequence">
        <article id="chapter-02"><p class="guide-folio"><span>02</span>Recover</p><h3>Understand first.</h3><p>Begin with evaluation and understanding. Address symptom reduction while establishing the foundation that later work can build on.</p></article>
        <article id="chapter-03"><p class="guide-folio"><span>03</span>Build</p><h3>Develop what the goal requires.</h3><p>Progress strength, mobility, control, capacity, and confidence in response to the person rather than a generic protocol.</p></article>
        <article id="chapter-04"><p class="guide-folio"><span>04</span>Perform</p><h3>Progress toward real demands.</h3><p>Connect the capacity developed in care to what each individual's chosen activities ask them to do.</p></article>
      </div></div>
    </section>

    <section id="chapter-05" class="guide-module" aria-labelledby="principles-title">
      <div class="margin-note"><span>Decision principles</span><p>The framework guides decisions without becoming a rigid timeline.</p></div>
      <article class="guide-module__body"><p class="guide-folio"><span>05</span>Individualized</p><h2 id="principles-title">Goals shape the sequence.</h2><p>The three stages are a framework, not a cookie-cutter plan. Care is built around individual goals, so the work and its progression reflect the person in front of the clinician.</p></article>
    </section>

    <section id="chapter-06" class="guide-module" aria-labelledby="applications-title">
      <div class="margin-note"><span>Audience applications</span><p>Active adults, athletes, weekend warriors, and strength and fitness enthusiasts bring different demands.</p></div>
      <article class="guide-module__body"><p class="guide-folio"><span>06</span>One-on-one</p><h2 id="applications-title">Reasoning stays connected to care.</h2><p>Forge delivers care one-on-one, adapting the progression to individual goals. For active adults, that can mean preparing for work, family, recreation, or daily activity. Athletes and weekend warriors can connect the stages to the demands of sport or recreation. Strength and fitness enthusiasts can build strength, mobility, control, capacity, and confidence around the training they want to pursue.</p></article>
    </section>

    <section id="chapter-07" class="guide-module guide-expectations" aria-labelledby="expectations-title">
      <div class="margin-note"><span>Expectations / FAQ</span><p>Recovery is the starting point. The route through the stages remains individual.</p></div>
      <article class="guide-module__body"><p class="guide-folio"><span>07</span>Build Forward</p><h2 id="expectations-title">Do not make less pain the finish line.</h2><details><summary>Is Recover, Build, Perform a fixed timeline?</summary><p>No. It is a framework adapted around individual goals, not a rigid protocol or one-size-fits-all benchmark.</p></details><details><summary>What does one-on-one care mean here?</summary><p>Evaluation, explanation, progression, and the demands of the goal remain in the same clinician-to-person conversation.</p></details></article>
    </section>

    <section id="chapter-08" class="guide-module guide-close" aria-labelledby="next-title">
      <div class="margin-note"><span>Current status</span><p>A real scheduling destination has not been supplied.</p></div>
      <article class="guide-module__body"><p class="guide-folio"><span>08</span>Next step</p><h2 id="next-title">Evaluation booking is not open online yet.</h2><p>Online scheduling will remain unavailable until a real scheduling destination is supplied. For now, the full Forge progression is here to read and consider.</p><div class="journal-actions"><BookingStatus /><a class="text-link" href="/concept-02">Return home</a></div></article>
    </section>
  </div>
</BlueprintLayout>
